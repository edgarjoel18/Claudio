# Copy to web/.streamlit/secrets.toml for local runs, OR paste these into
# Streamlit Community Cloud → App → Settings → Secrets.
# These are NOT your OpenAI key — they point the demo at your hosted proxy.

CLAUDIO_API_BASE = "https://claudio-proxy-x1y1.onrender.com/v1"
CLAUDIO_API_KEY  = "your-proxy-access-token"

# Optional overrides
# CHAT_MODEL  = "gpt-4o-mini"
# EMBED_MODEL = "text-embedding-3-small"
