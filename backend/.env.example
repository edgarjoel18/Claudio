# Copy to backend/.env for local runs. On Render/Railway, set these as
# environment variables in the dashboard instead — never commit the real key.

# Your REAL OpenAI key. Lives ONLY here / on the server. Never ships to clients.
OPENAI_API_KEY=sk-your-real-openai-key

# Tokens you hand to recruiters (comma-separated). Rotate/revoke by editing this.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
PROXY_ACCESS_TOKENS=demo-token-1,demo-token-2

# Hard monthly spend cap in USD. Proxy stops forwarding once exceeded.
MONTHLY_USD_CAP=20

# Per-token request rate limit (requests per minute).
RATE_LIMIT_PER_MIN=20

# Models clients are allowed to request (comma-separated).
ALLOWED_MODELS=gpt-4o,gpt-4o-mini,text-embedding-3-small

# Optional: override the price table (USD per 1M tokens) if OpenAI pricing changes.
# PRICES_JSON={"gpt-4o":{"input":2.5,"output":10.0}}
