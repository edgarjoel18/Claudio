# Copy this file to `.env` (in this same claudio/ folder) and fill in real values.
#   cp claudio/.env.example claudio/.env
# Never commit your real .env — it is gitignored.

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ADMIN_KEY=

# Qdrant vector store (required — default RAG backend)
# Local:  http://localhost:6333   (leave QDRANT_API_KEY blank)
# Cloud:  https://<cluster>.qdrant.io  + the cluster API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings / ChromaDB (only used when rag.mode = semantic + chroma)
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=.chromadb/
CHROMA_COLLECTION=codebase

# Elasticsearch (optional — not required for default hybrid Qdrant mode)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=codebase

# Neo4j (optional)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# LangSmith tracing (optional — set LANGSMITH_TRACING=false to silence warnings)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Guardrails
GUARDRAIL_SHOW_REDACTED_INPUT=false
